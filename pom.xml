<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>ru.truwlf</groupId>
    <artifactId>TrueCombat</artifactId>
    <version>2.2.0</version>
    <name>TrueCombat</name>
    <description>Fast, lightweight combat protection for Bukkit-compatible Minecraft servers.</description>
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <server-api.groupId>io.papermc.paper</server-api.groupId>
        <server-api.artifactId>paper-api</server-api.artifactId>
        <paper-api.version>1.20.1-R0.1-SNAPSHOT</paper-api.version>
        <artifact.suffix>1.20.x</artifact.suffix>
    </properties>
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>${server-api.groupId}</groupId>
            <artifactId>${server-api.artifactId}</artifactId>
            <version>${paper-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-minimessage</artifactId>
            <version>4.17.0</version>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-legacy</artifactId>
            <version>4.17.0</version>
        </dependency>
    </dependencies>
    <build>
        <finalName>TrueCombat-${artifact.suffix}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration><release>${maven.compiler.release}</release></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration><createDependencyReducedPom>false</createDependencyReducedPom><relocations><relocation><pattern>net.kyori</pattern><shadedPattern>ru.truwlf.truecombat.lib.adventure</shadedPattern></relocation></relocations></configuration></execution></executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>spigot-1.20</id>
            <properties>
                <server-api.groupId>org.spigotmc</server-api.groupId>
                <server-api.artifactId>spigot-api</server-api.artifactId>
                <paper-api.version>1.20.1-R0.1-SNAPSHOT</paper-api.version>
                <artifact.suffix>Spigot-1.20.x</artifact.suffix>
                <maven.compiler.release>17</maven.compiler.release>
            </properties>
        </profile>
        <profile>
            <id>mc-1.20</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <properties>
                <paper-api.version>1.20.1-R0.1-SNAPSHOT</paper-api.version>
                <artifact.suffix>1.20.x</artifact.suffix>
                <maven.compiler.release>17</maven.compiler.release>
            </properties>
        </profile>
        <profile>
            <id>spigot-1.21</id>
            <properties>
                <server-api.groupId>org.spigotmc</server-api.groupId>
                <server-api.artifactId>spigot-api</server-api.artifactId>
                <paper-api.version>1.21.1-R0.1-SNAPSHOT</paper-api.version>
                <artifact.suffix>Spigot-1.21.x</artifact.suffix>
                <maven.compiler.release>21</maven.compiler.release>
            </properties>
        </profile>
        <profile>
            <id>mc-1.21</id>
            <properties>
                <paper-api.version>1.21.11-R0.1-SNAPSHOT</paper-api.version>
                <artifact.suffix>1.21.x</artifact.suffix>
                <maven.compiler.release>21</maven.compiler.release>
            </properties>
        </profile>
        <profile>
            <id>mc-26-1</id>
            <properties>
                <paper-api.version>26.1.1.build.29-alpha</paper-api.version>
                <artifact.suffix>26.1.x</artifact.suffix>
                <maven.compiler.release>25</maven.compiler.release>
            </properties>
        </profile>
        <profile>
            <id>mc-26</id>
            <properties>
                <paper-api.version>26.2.build.112-stable</paper-api.version>
                <artifact.suffix>26.2</artifact.suffix>
                <maven.compiler.release>25</maven.compiler.release>
            </properties>
        </profile>
    </profiles>
</project>
